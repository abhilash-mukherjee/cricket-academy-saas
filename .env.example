# Copy to `.env` (gitignored) and fill from the Neon dashboard.
# App traffic uses the pooled URL. drizzle-kit migrate uses the unpooled URL.
# Local development uses Neon `dev`, not a local Postgres.

# Neon `dev` (local + Vercel `dev` / Preview)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon `staging` — laptop migrate after promoting to git `staging`
STAGING_DATABASE_URL_UNPOOLED=

# Neon `production` — laptop migrate after promoting to git `main`
PRODUCTION_DATABASE_URL_UNPOOLED=

# Staff auth (Better Auth + Resend)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPER_ADMIN_EMAIL=
